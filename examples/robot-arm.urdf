<?xml version="1.0"?>
<!-- A small arm in URDF for «Файл → Импорт…» (plugins/urdf): a base fixed to the floor, a waist that turns all the way
     round, a shoulder and an elbow with limits, a hand welded to the forearm and a finger that slides. z up, as URDF. -->
<robot name="Рука URDF">
  <material name="graphite"><color rgba="0.28 0.28 0.3 1"/></material>
  <material name="blue"><color rgba="0.35 0.55 0.85 1"/></material>
  <material name="orange"><color rgba="1 0.57 0.16 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.3 0.3 0.1"/></geometry><material name="graphite"/></visual>
    <inertial><mass value="5"/></inertial>
  </link>

  <joint name="waist" type="continuous">
    <parent link="base_link"/><child link="turret"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
  </joint>
  <link name="turret">
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.08" length="0.1"/></geometry><material name="blue"/></visual>
    <inertial><mass value="2"/></inertial>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="turret"/><child link="upper_arm"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="60" velocity="2"/>
  </joint>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.2"/><geometry><box size="0.06 0.06 0.4"/></geometry><material name="blue"/></visual>
    <inertial><mass value="1.5"/></inertial>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.4"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="30" velocity="2"/>
  </joint>
  <link name="forearm">
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.05 0.05 0.3"/></geometry><material name="blue"/></visual>
    <inertial><mass value="1"/></inertial>
  </link>

  <joint name="wrist" type="fixed">
    <parent link="forearm"/><child link="hand"/>
    <origin xyz="0 0 0.3"/>
  </joint>
  <link name="hand">
    <visual><geometry><sphere radius="0.04"/></geometry><material name="orange"/></visual>
    <inertial><mass value="0.3"/></inertial>
  </link>

  <joint name="tool" type="fixed">
    <parent link="hand"/><child link="tool0"/>
    <origin xyz="0 0 0.04"/>
  </joint>
  <link name="tool0"/>

  <joint name="finger" type="prismatic">
    <parent link="tool0"/><child link="finger"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.03" effort="20" velocity="0.1"/>
  </joint>
  <link name="finger">
    <visual><origin xyz="0 0 0.03"/><geometry><box size="0.02 0.02 0.06"/></geometry><material name="orange"/></visual>
    <inertial><mass value="0.05"/></inertial>
  </link>
</robot>
